<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.startup">
    <startup class="com.simone.changelens.EditorStartup"/>
  </extension>

  <extension point="org.eclipse.core.runtime.preferences">
    <initializer class="com.simone.changelens.preferences.PreferenceInitializer"/>
  </extension>

  <extension point="org.eclipse.ui.preferencePages">
    <page id="com.simone.changelens.preferences" name="ChangeLens"
          category="org.eclipse.ui.preferencePages.GeneralTextEditor"
          class="com.simone.changelens.preferences.ChangeLensPreferencePage"/>
  </extension>

  <!-- Nessun tipo di annotazione contribuito: la barra panoramica di destra
       resta quella di Eclipse, con errori, warning, task e segnalibri e
       nient'altro. Le informazioni Git stanno solo nella colonna a sinistra. -->
</plugin>
